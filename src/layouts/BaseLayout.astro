---
import SEO from '../components/SEO.astro'
import '../styles/global.css'

export interface Props {
  title: string
  description: string
  ogImage?: string
  event?: Parameters<typeof SEO>[0]['event']
}

const { title, description, ogImage, event } = Astro.props

const ga4Id = import.meta.env.PUBLIC_GA4_ID
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<!doctype html>
<html lang="es">
  <head>
    <SEO
      title={title}
      description={description}
      canonicalURL={new URL(Astro.url.pathname, Astro.site)}
      ogImage={ogImage}
      event={event}
    />

    <!-- Google Analytics 4 -->
    {ga4Id && ga4Id !== 'G-XXXXXXXXXX' && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
        <script define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4Id, { anonymize_ip: true, cookie_flags: 'SameSite=None;Secure' });
        </script>
      </>
    )}

    <!-- Cloudflare Web Analytics -->
    {cfAnalyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`} />
    )}
  </head>

  <body>
    <a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>

    <!-- ============================================================
         HEADER — fixed, blanco sólido desde el inicio.
         Nav: EQUIPO · QUÉ ES TEDx · EVENTO · PARTNERS · CONTACTO + POSTULAR rojo
         ============================================================ -->
    <header class="site-header" id="site-header" role="banner">
      <div class="site-header__inner">
        <a href="#inicio" class="site-header__logo-link" aria-label="TEDxBarrioUniversitario Women — ir al inicio">
          <img
            src={`${baseUrl}/logo-tedx-blanco.png`}
            alt=""
            width="160"
            height="60"
            loading="eager"
            decoding="async"
            class="site-header__logo site-header__logo--blanco"
            aria-hidden="true"
          />
          <img
            src={`${baseUrl}/logo-tedx-negro.png`}
            alt=""
            width="160"
            height="60"
            loading="eager"
            decoding="async"
            class="site-header__logo site-header__logo--negro"
            aria-hidden="true"
          />
        </a>

        <nav aria-label="Navegación principal" class="site-header__nav">
          <a href="#equipo"        class="header-nav-link header-nav-wide">Equipo</a>
          <a href="#que-es-tedx"   class="header-nav-link header-nav-wide">¿Qué es TED<span class="lc">x</span>?</a>
          <a href="#evento"        class="header-nav-link header-nav-wide">Evento</a>
          <a href="#partners"      class="header-nav-link header-nav-wide">Partners</a>
          <a href="#contacto"      class="header-nav-link header-nav-wide">Contacto</a>
          <a href="#speakers"      class="header-nav-link btn-header-cta"
             aria-label="Postular como speaker al TEDxBarrioUniversitario Women 2026">
            Postular →
          </a>
        </nav>

        <!-- Hamburguesa: solo visible ≤639px -->
        <button
          id="burger-btn"
          class="site-header__burger"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="burger-bar"></span>
          <span class="burger-bar"></span>
          <span class="burger-bar"></span>
        </button>
      </div>

      <!-- Panel móvil (oculto por defecto) -->
      <nav
        id="mobile-nav"
        class="mobile-nav"
        aria-label="Menú móvil"
        hidden
      >
        <a href="#equipo"     class="mobile-nav__link" data-close-menu>Equipo</a>
        <a href="#que-es-tedx" class="mobile-nav__link" data-close-menu>¿Qué es TED<span class="lc">x</span>?</a>
        <a href="#evento"     class="mobile-nav__link" data-close-menu>Evento</a>
        <a href="#partners"   class="mobile-nav__link" data-close-menu>Partners</a>
        <a href="#contacto"   class="mobile-nav__link" data-close-menu>Contacto</a>
        <a href="#speakers"   class="mobile-nav__link mobile-nav__link--cta" data-close-menu
           aria-label="Postular como speaker al TEDxBarrioUniversitario Women 2026">
          Postular →
        </a>
      </nav>
    </header>

    <!-- WCAG 2.4.1: tabindex="-1" permite que el skip-link mueva el foco -->
    <main id="contenido-principal" tabindex="-1">
      <slot />
    </main>

    <!-- ============================================================
         FOOTER — oscuro charcoal + borde rojo superior
         Columnas: Evento · Participar · Conoce más
         Redes: IG · LinkedIn · Flickr
         Crédito: Anami Studio
         ============================================================ -->
    <footer class="site-footer dark-section" role="contentinfo">
      <div class="site-footer__inner">
        <div class="site-footer__top">

          <!-- Marca + redes -->
          <div class="site-footer__brand">
            <img
              src={`${baseUrl}/logo-tedx-blanco.png`}
              alt="TEDxBarrioUniversitario Women"
              width="160"
              height="60"
              loading="lazy"
              decoding="async"
              class="site-footer__logo"
            />
            <p class="site-footer__tagline">
              Alzar el vuelo
            </p>
            <nav aria-label="Redes sociales de TEDxBarrioUniversitario">
              <ul class="site-footer__social">
                <li>
                  <a href="https://www.instagram.com/tedxbarriouniversitario"
                     rel="noopener noreferrer" target="_blank"
                     class="site-footer__social-link"
                     aria-label="Instagram de TEDxBarrioUniversitario (abre en nueva pestaña)">
                    <!-- Instagram icon -->
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                    <span>Instagram</span>
                  </a>
                </li>
                <li>
                  <a href="https://www.linkedin.com/company/tedxbarriouniversitario"
                     rel="noopener noreferrer" target="_blank"
                     class="site-footer__social-link"
                     aria-label="LinkedIn de TEDxBarrioUniversitario (abre en nueva pestaña)">
                    <!-- LinkedIn icon -->
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    <span>LinkedIn</span>
                  </a>
                </li>
                <li>
                  <a href="https://www.flickr.com/photos/tedxbarriouniversitario"
                     rel="noopener noreferrer" target="_blank"
                     class="site-footer__social-link"
                     aria-label="Flickr de TEDxBarrioUniversitario (abre en nueva pestaña)">
                    <!-- Flickr icon -->
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M5.334 6C2.39 6 0 8.39 0 11.334c0 2.942 2.39 5.332 5.334 5.332 2.942 0 5.332-2.39 5.332-5.332C10.666 8.39 8.276 6 5.334 6zm13.332 0c-2.942 0-5.332 2.39-5.332 5.334 0 2.942 2.39 5.332 5.332 5.332C21.61 16.666 24 14.276 24 11.334 24 8.39 21.61 6 18.666 6z"/>
                    </svg>
                    <span>Flickr</span>
                  </a>
                </li>
              </ul>
            </nav>
          </div>

          <!-- Columna: Evento -->
          <div>
            <h3 class="site-footer__heading">Evento</h3>
            <ul class="site-footer__list">
              <li><a href="#concepto" class="site-footer__link">Alzar el vuelo</a></li>
              <li>04 Dic 2026</li>
              <li>Universidad de Concepción</li>
              <li>Concepción, Chile</li>
            </ul>
          </div>

          <!-- Columna: Participar -->
          <div>
            <h3 class="site-footer__heading">Participar</h3>
            <ul class="site-footer__list">
              <li><a href="#contacto" class="site-footer__link">Contacto</a></li>
              <li>
                <a href="https://docs.google.com/forms/d/1c1CFQSXlb-diJSRwZCDvsV5lzHA8y5p3zzs5atz7_YE/viewform"
                   target="_blank" rel="noopener noreferrer"
                   class="site-footer__link"
                   aria-label="Quiero ser Partner — formulario (abre en nueva pestaña)">
                  Quiero ser Partner ↗
                </a>
              </li>
              <li>
                <a href="https://docs.google.com/forms/d/15njQTb5kpHgN1O_7wST56SnzuHblA3rowGsJNlhyYu0/viewform"
                   target="_blank" rel="noopener noreferrer"
                   class="site-footer__link"
                   aria-label="Postular como Speaker — formulario (abre en nueva pestaña)">
                  Postular como Speaker ↗
                </a>
              </li>
            </ul>
          </div>

          <!-- Columna: Conoce más -->
          <div>
            <h3 class="site-footer__heading">Conoce más</h3>
            <ul class="site-footer__list">
              <li><a href="#equipo"       class="site-footer__link">Equipo</a></li>
              <li><a href="#que-es-tedx"  class="site-footer__link">¿Qué es TEDx?</a></li>
              <li>
                <a href="https://www.ted.com/tedx/events/69535"
                   target="_blank" rel="noopener noreferrer"
                   class="site-footer__link"
                   aria-label="TEDxBarrioUniversitario Women en TED.com (abre en nueva pestaña)">
                  TEDxBarrioUniversitario Women ↗
                </a>
              </li>
            </ul>
          </div>

        </div>

        <!-- Bottom bar: copyright + crédito Anami -->
        <div class="site-footer__bottom">
          <span>© {new Date().getFullYear()} TEDxBarrioUniversitario Women · Concepción, Chile</span>
          <span class="text-white/40 text-xs hidden sm:block">
            Organizado de forma independiente bajo licencia TED. Las opiniones expresadas son exclusivas de sus organizadores y no representan a TED Conferences LLC.
          </span>
          <a href="https://anami.cl"
             target="_blank"
             rel="noopener noreferrer"
             class="site-footer__anami-credit"
             aria-label="Sitio web desarrollado por Anami Studio (abre en nueva pestaña)">
            Sitio desarrollado por Anami Studio ↗
          </a>
        </div>
      </div>
    </footer>


  <!-- Botón scroll-to-top -->
  <button
    id="btn-top"
    class="btn-top"
    aria-label="Volver al inicio de la página"
    aria-hidden="true"
    tabindex="-1"
  >
    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" fill="none">
      <path d="M10 15V5M10 5L5 10M10 5L15 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <script>
    /* ── Header transparente → blanco al hacer scroll ───────── */
    (function () {
      var header = document.getElementById('site-header');
      if (!header) return;
      function updateHeader() {
        header.classList.toggle('site-header--scrolled', window.scrollY > 40);
      }
      window.addEventListener('scroll', updateHeader, { passive: true });
      updateHeader();
    })();
  </script>

  <script>
    (function () {
      var btn = document.getElementById('btn-top');
      if (!btn) return;

      function toggleBtn() {
        var visible = window.scrollY > 400;
        btn.classList.toggle('btn-top--visible', visible);
        btn.setAttribute('aria-hidden', String(!visible));
        btn.tabIndex = visible ? 0 : -1;
      }

      window.addEventListener('scroll', toggleBtn, { passive: true });
      toggleBtn();

      btn.addEventListener('click', function () {
        var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: prefersReduced ? 'instant' : 'smooth' });
      });
    })();
  </script>

  <script>
    /* ── Menú hamburguesa móvil ─────────────────────────────── */
    (function () {
      var burgerBtn = document.getElementById('burger-btn');
      var mobileNav = document.getElementById('mobile-nav');
      if (!burgerBtn || !mobileNav) return;

      function openMenu() {
        mobileNav.removeAttribute('hidden');
        burgerBtn.setAttribute('aria-expanded', 'true');
        burgerBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
      }

      function closeMenu() {
        mobileNav.setAttribute('hidden', '');
        burgerBtn.setAttribute('aria-expanded', 'false');
        burgerBtn.setAttribute('aria-label', 'Abrir menú de navegación');
      }

      burgerBtn.addEventListener('click', function () {
        burgerBtn.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
      });

      /* Cerrar con Escape y devolver foco al botón */
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && burgerBtn.getAttribute('aria-expanded') === 'true') {
          closeMenu();
          burgerBtn.focus();
        }
      });

      /* Cerrar al hacer click en cualquier link del panel */
      mobileNav.querySelectorAll('[data-close-menu]').forEach(function (link) {
        link.addEventListener('click', closeMenu);
      });

      /* Cerrar automáticamente al pasar a desktop */
      var mq = window.matchMedia('(min-width: 640px)');
      mq.addEventListener('change', function (e) {
        if (e.matches) closeMenu();
      });
    })();
  </script>

  </body>
</html>

<style>
/* ============================================================
   HEADER — fixed, transparente inicial → blanco al hacer scroll
   ============================================================ */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
  box-shadow: none;
  transition: background 0.3s ease, box-shadow 0.3s ease;
}
.site-header--scrolled {
  background: #ffffff;
  box-shadow: 0 1px 8px rgba(0,0,0,0.08);
}

.site-header__inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 12px clamp(16px, 4vw, 32px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.site-header__logo-link {
  display: flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
}

.site-header__logo {
  height: 56px;
  width: auto;
  display: block;
}
/* Logos: blanco visible por defecto; negro visible al hacer scroll.
   Estas reglas van DESPUÉS de display:block para ganar por orden en cascada. */
.site-header__logo--negro { display: none; }
.site-header--scrolled .site-header__logo--blanco { display: none; }
.site-header--scrolled .site-header__logo--negro { display: block; }

.site-header__nav {
  display: flex;
  align-items: center;
  gap: clamp(12px, 2vw, 20px);
}

/* Links blancos sobre fondo transparente → charcoal al hacer scroll */
.header-nav-link {
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.92);
  text-decoration: none;
  padding: 8px 4px;
  white-space: nowrap;
  transition: color 0.15s ease;
}
.header-nav-link:hover { color: #ffffff; }
.site-header--scrolled .header-nav-link { color: var(--color-charcoal); }
.site-header--scrolled .header-nav-link:hover { color: var(--color-ted-red); }

/* Botón rojo CTA */
.btn-header-cta {
  background: var(--color-ted-red);
  color: #ffffff !important;
  font-family: var(--font-display);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 8px 18px;
  border-radius: 4px;
  text-decoration: none;
  transition: background 0.15s ease;
  white-space: nowrap;
}
.btn-header-cta:hover { background: var(--color-ted-red-dark); }
.btn-header-cta:focus-visible {
  outline: 2px solid #ffffff;
  outline-offset: 2px;
  box-shadow: 0 0 0 4px var(--color-charcoal);
}

/* Responsive nav */
@media (max-width: 639px) {
  /* Ocultar el contenedor nav completo — no solo sus hijos — para que el burger no quede desplazado */
  .site-header__nav { display: none !important; }
  .site-header__logo { height: 52px; }
}
/* Tablet 640–900px: links visibles, fuente y gaps reducidos */
@media (min-width: 640px) and (max-width: 900px) {
  .header-nav-link { font-size: 0.7rem; padding: 6px 2px; }
  .btn-header-cta  { font-size: 0.7rem; padding: 6px 12px; }
  .site-header__nav { gap: 8px; }
  .site-header__logo { height: 44px; }
}

/* ── Hamburguesa ────────────────────────────────────────────── */
.site-header__burger {
  display: none; /* oculto en desktop/tablet */
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 44px;
  height: 44px;
  padding: 10px;
  background: none;
  border: none;
  cursor: pointer;
  border-radius: 4px;
  flex-shrink: 0;
}
.site-header__burger:focus-visible {
  outline: 2px solid var(--color-ted-red);
  outline-offset: 3px;
  box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.85);
}
.site-header--scrolled .site-header__burger:focus-visible {
  box-shadow: 0 0 0 5px rgba(35, 35, 35, 0.25);
}
.burger-bar {
  display: block;
  width: 22px;
  height: 2px;
  background: #ffffff;
  border-radius: 2px;
  transition: transform 0.22s ease, opacity 0.22s ease, background 0.3s ease;
}
.site-header--scrolled .burger-bar { background: var(--color-charcoal); }
/* Ícono X cuando el menú está abierto */
.site-header__burger[aria-expanded="true"] .burger-bar:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}
.site-header__burger[aria-expanded="true"] .burger-bar:nth-child(2) {
  opacity: 0;
}
.site-header__burger[aria-expanded="true"] .burger-bar:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

@media (max-width: 639px) {
  .site-header__burger { display: flex; }
}

/* ── Panel de navegación móvil ─────────────────────────────── */
.mobile-nav {
  position: absolute;
  top: 100%; /* pegar bajo el header */
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1px solid rgba(35,35,35,0.08);
  box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  z-index: 99;
  display: flex;
  flex-direction: column;
  padding: 8px 0 16px;
}
/* hidden attr controla visibilidad — el !important asegura que el CSS no lo anule */
.mobile-nav[hidden] { display: none !important; }

.mobile-nav__link {
  font-family: var(--font-display);
  font-size: 0.9rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-charcoal);
  text-decoration: none;
  padding: 14px 24px;
  border-bottom: 1px solid rgba(35,35,35,0.06);
  transition: color 0.15s, background 0.15s;
}
.mobile-nav__link:last-child { border-bottom: none; }
.mobile-nav__link:hover { color: var(--color-ted-red); background: rgba(219,0,40,0.04); }

.mobile-nav__link--cta {
  margin: 12px 24px 0;
  padding: 12px 20px;
  background: var(--color-ted-red);
  color: #ffffff !important;
  border-radius: 4px;
  border-bottom: none;
  text-align: center;
}
.mobile-nav__link--cta:hover { background: #b8001f; }

/* ============================================================
   FOOTER — charcoal oscuro + borde rojo
   ============================================================ */
.site-footer {
  background: var(--color-charcoal);
  color: #fff;
  border-top: 3px solid var(--color-ted-red);
}

.site-footer__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: clamp(44px, 6vw, 72px) clamp(16px, 5vw, 32px) 28px;
}

.site-footer__top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: clamp(24px, 4vw, 48px);
}

@media (max-width: 768px) {
  .site-footer__top {
    grid-template-columns: 1fr 1fr;
    gap: 28px 20px;
  }
  .site-footer__brand { grid-column: 1 / -1; }
}
@media (max-width: 480px) {
  .site-footer__top { grid-template-columns: 1fr; }
}

.site-footer__logo {
  height: 40px;
  width: auto;
  display: block;
  margin-bottom: 14px;
  filter: brightness(0) invert(1);
}

.site-footer__tagline {
  font-size: 0.875rem;
  line-height: 1.6;
  color: rgba(255,255,255,0.75);
  max-width: 28ch;
  margin: 0 0 16px;
