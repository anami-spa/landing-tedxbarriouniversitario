---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

// Imágenes procesadas por astro:assets (WebP, srcset automático)
import imgHero from "../assets/images/hero-01.webp";
import imgEquipoJav from "../assets/images/equipo-javiera-polaroid.png";
import imgEquipoPau from "../assets/images/equipo-paula-polaroid.png";
import imgEquipoPam from "../assets/images/equipo-pamela-polaroid.png";
import imgEquipoGab from "../assets/images/equipo-gabriela-polaroid.png";
import imgEquipoNat from "../assets/images/equipo-natalie-polaroid.png";
import imgEquipoCla from "../assets/images/equipo-claudio.png";
import imgFotoSec02 from "../assets/images/foto-seccion-02.webp";
import imgMujerS4 from "../assets/images/s4-mujer.png";
import imgFicha from "../assets/images/ficha-mujer-05.webp";
import imgConvoca from "../assets/images/convocatoria-speakers.webp";
import imgAlzarVuelo01 from "../assets/images/alzar-vuelo-01.webp";
import imgTedxOficial from "../assets/images/tedx-logo-oficial.png";
import imgIcoLinkedin from "../assets/images/icono-linkedin.webp";
import imgAuspiciador from "../assets/images/auspiciador-02.webp";
import imgIcoIG from "../assets/images/icono-ig.webp";
import imgIcoIN from "../assets/images/icono-in.webp";
import imgIcoFKR from "../assets/images/icono-fkr.webp";
import imgContactoPolaroid from "../assets/images/contacto-polaroid.webp";
import imgContactoFoto from "../assets/images/contacto-foto.webp";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

// ============================================================
// CONTENIDO — fuente de verdad. Editar aquí, nunca inventar datos.
// ============================================================

const evento = {
  nombre: "TEDxBarrioUniversitario Women 2026",
  tema: "Alzar el vuelo",
  fecha: "04 de Diciembre, 2026",
  horario: "09:00 — 13:00",
  lugar: "Universidad de Concepción",
  auditorio: "Auditorio [por confirmar]",
  ciudad: "Concepción, Chile",
  speakers: 8,
  asistentes: 100,
  ideas: 1,
  url: "https://www.ted.com/tedx/events/69535",
  email: "contacto@tedxbarriouniversitario.cl",
  emailAlianzas: "alianzas@tedxbarriouniversitario.cl",
  ig: "@tedxbarriouniversitario",
  linkedin: "tedxbarriouniversitario",
  flickr: "tedxbarriouniversitario",
  countdown: "2026-12-04T09:00:00-03:00",
};

const equipo = [
  {
    nombre: "Javiera Burgos",
    cargo: "Organizadora y Directora General",
    img: imgEquipoJav,
    slug: "javiera",
    linkedin: "javieraburgosb",
  },
  {
    nombre: "Paula Cifuentes",
    cargo: "Directora de Comunicaciones",
    img: imgEquipoPau,
    slug: "paula",
    linkedin: "paulacifuentes",
  },
  {
    nombre: "Pamela Pérez",
    cargo: "Curaduría y Speaker Coach",
    img: imgEquipoPam,
    slug: "pamela",
    linkedin: "pamelapereztoledo",
  },
  {
    nombre: "Claudio Muñoz",
    cargo: "Alianzas Estratégicas y Coach de Equipo",
    img: imgEquipoCla,
    slug: "claudio",
    linkedin: "claudiomunozgarnica",
  },
  {
    nombre: "Gabriela Concha",
    cargo: "Producción y Logística",
    img: imgEquipoGab,
    slug: "gabriela",
    linkedin: "gabriela-concha-289a322a",
  },
  {
    nombre: "Natalie Aguayo",
    cargo: "Directora Creativa",
    img: imgEquipoNat,
    slug: "natalie",
    linkedin: "natalie-aguayo-espinoza",
  },
];

const tematicas = [
  "Liderazgo femenino",
  "Ciencia, tecnología y futuro (STEM)",
  "Innovación y emprendimiento",
  "Bienestar y calidad de vida",
  "Equidad de género",
  "Impacto social y sostenibilidad",
];

const beneficios = [
  {
    icono: "📍",
    titulo: "Posicionamiento",
    texto:
      "Vincula tu marca al ecosistema TED, reconocido globalmente por el impacto de sus ideas.",
  },
  {
    icono: "🌿",
    titulo: "Marca con propósito",
    texto:
      "Asocia tu organización a valores de innovación, equidad y transformación social.",
  },
  {
    icono: "👁️",
    titulo: "Visibilidad estratégica",
    texto:
      "Presencia ante líderes, académicos, emprendedores y la comunidad universitaria del Biobío.",
  },
  {
    icono: "🤝",
    titulo: "Networking de alto valor",
    texto:
      "Conecta con una audiencia selecta de personas movilizadas por ideas y propósito.",
  },
];

const procesoSpeaker = [
  {
    num: "01",
    titulo: "Completa el formulario",
    desc: "Postula con tu idea a través del formulario oficial de convocatoria.",
  },
  {
    num: "02",
    titulo: "Video presentación",
    desc: "Envía un video breve presentando tu idea y motivaciones.",
  },
  {
    num: "03",
    titulo: "Entrevista con el equipo curatorial",
    desc: "El equipo editorial evalúa tu propuesta y toma contacto contigo.",
  },
];

const partners = [
  {
    categoria: "Institución Anfitriona",
    logos: [{ src: "udec-negro.svg", alt: "Universidad de Concepción", tipo: "anfitrion" }],
  },
  {
    categoria: "Partner Estratégico",
    logos: [
      { src: "linac.svg", alt: "LINAC", tipo: "normal" },
      { src: "anami-negro.png", alt: "ANAMI Spa", tipo: "normal" },
    ],
  },
  {
    categoria: "Partner Colaborador",
    logos: [
      { src: "empoderadas.svg", alt: "Empoderadas", tipo: "normal" },
      { src: "kine-rehabilita.svg", alt: "Kine Rehabilita", tipo: "normal" },
    ],
  },
  {
    categoria: "Partner Impulsor",
    logos: [{ src: "vic-udec.svg", alt: "Vinculación Universidad de Concepción", tipo: "normal" }],
  },
  {
    categoria: "Partner Pyme",
    logos: [
      { src: "grafitto.svg", alt: "Grafitto", tipo: "normal" },
      { src: "sistemico.svg", alt: "Sistémico", tipo: "normal" },
    ],
  },
];

const seoEvent = {
  name: "TEDxBarrioUniversitario Women 2026 — Alzar el vuelo",
  description:
    "Evento TEDx independiente en la Universidad de Concepción. 8 charlas en vivo sobre ideas que transforman. 4 de diciembre de 2026.",
  startDate: "2026-12-04T09:00:00-03:00",
  endDate: "2026-12-04T13:00:00-03:00",
  url: "https://tedxbarriouniversitario.cl",
  location: {
    name: "Universidad de Concepción",
    address: "Campus UdeC",
    city: "Concepción",
    country: "CL",
  },
  organizer: "TEDxBarrioUniversitario Women",
};
---

<BaseLayout
  title="TEDxBarrioUniversitario Women 2026 · Alzar el vuelo"
  description="8 charlas que inspiran. 4 de diciembre de 2026 · Universidad de Concepción · Ideas que conectan, voces que transforman."
  ogImage="/og-tedx.jpg"
  event={seoEvent}
>
  <!-- ============================================================
     S1 — HERO OSCURO "Alzar el vuelo"
     Foto full-bleed fondo. Texto vertical izquierda. Countdown inferior.
     ============================================================ -->
  <section
    id="inicio"
    class="s-hero dark-section"
    aria-label="Inicio — Alzar el vuelo"
  >
    <!-- Foto de fondo full-bleed con gradiente oscuro -->
    <div class="hero-bg" aria-hidden="true">
      <Image
        src={imgHero}
        alt=""
        width={1600}
        height={1000}
        loading="eager"
        decoding="async"
        class="hero-bg__img"
      />
    </div>

    <!-- Wordmark del diseñador: PNG fidelidad 1:1. H1 sr-only para a11y. -->
    <div class="hero-content">
      <h1 class="sr-only">
        Alzar el vuelo — TEDxBarrioUniversitario Women 2026
      </h1>
      <div class="hero-title-row">
        <Image
          src={imgAlzarVuelo01}
          alt=""
          width={700}
          height={475}
          loading="eager"
          decoding="async"
          class="hero-wordmark"
          aria-hidden="true"
        />
      </div>
    </div>
  </section>

  <!-- ============================================================
     COUNTDOWN — Isla flotante solapada entre S1 y S2
     ============================================================ -->
  <div class="cd-island-wrap">
    <div class="cd-island" role="timer" aria-label="Cuenta regresiva al evento">
      <span class="sr-only"
        >El evento es el 4 de diciembre de 2026 a las 09:00 hrs.</span
      >
      <div class="cd-island__inner" aria-hidden="true">
        <div class="countdown-unit">
          <span class="countdown-label">DÍAS</span>
          <span class="countdown-num mono-date" id="cd-dias">--</span>
        </div>
        <span class="countdown-sep">:</span>
        <div class="countdown-unit">
          <span class="countdown-label">HORAS</span>
          <span class="countdown-num mono-date" id="cd-horas">--</span>
        </div>
        <span class="countdown-sep">:</span>
        <div class="countdown-unit">
          <span class="countdown-label">MINUTOS</span>
          <span class="countdown-num mono-date" id="cd-min">--</span>
        </div>
        <span class="countdown-sep">:</span>
        <div class="countdown-unit">
          <span class="countdown-label">SEGUNDOS</span>
          <span class="countdown-num mono-date" id="cd-seg">--</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================
     S2 — EN COLABORACIÓN (equipo)
     Fondo claro. Grid 6 headshots reales.
     ============================================================ -->
  <section
    id="equipo"
    class="s-equipo seccion-light texture-overlay"
    aria-labelledby="h-equipo"
  >
    <div class="seccion-inner">
      <!-- Intro 2 columnas: título izq + párrafo der -->
      <div class="s-equipo__intro">
        <div class="s-equipo__intro-left">
          <p class="eyebrow-label s-equipo__eyebrow">
            UN EVENTO CONSTRUIDO
            <span class="flecha-roja" aria-hidden="true">
              <svg
                width="44"
                height="24"
                viewBox="0 0 44 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M0 12H40M40 12L28 2M40 12L28 22"
                  stroke="#db0028"
                  stroke-width="5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </p>
          <h2 id="h-equipo" class="s-equipo__titulo display-black">
            EN COLABORACIÓN
          </h2>
        </div>
        <p class="s-equipo__desc">
          TEDxBarrioUniversitario Women es una iniciativa voluntaria y sin fines
          de lucro, orientada exclusivamente a crear un espacio para la difusión
          de ideas que inspiren transformación. Cada persona involucrada
          participa desde la convicción, el compromiso y el propósito de generar
          un impacto positivo en nuestra comunidad.
        </p>
      </div>

      <ul class="equipo-grid" role="list">
        {
          equipo.map((m) => (
            <li class="equipo-card" role="listitem">
              <Image
                src={m.img}
                alt={m.nombre}
                width={300}
                height={400}
                loading="lazy"
                decoding="async"
                class="equipo-card__foto"
              />
              <div class="equipo-card__nombre-zona">
                <a
                  href={`https://linkedin.com/in/${m.linkedin}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="equipo-card__linkedin"
                  aria-label={`LinkedIn de ${m.nombre} (abre en nueva pestaña)`}
                >
                  <Image
                    src={imgIcoLinkedin}
                    alt=""
                    width={16}
                    height={16}
                    aria-hidden="true"
                    class="equipo-card__linkedin-ico"
                  />
                  <span class="equipo-card__nombre headline-bold">
                    {m.nombre}
                  </span>
                </a>
              </div>
              <p class="equipo-card__cargo">{m.cargo}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================================================
     S3 — ¿QUÉ ES TEDx?
     Fondo oscuro. 1 col: texto full + SVG curvo decorativo.
     ============================================================ -->
  <section
    id="que-es-tedx"
    class="s-que-es dark-section"
    aria-labelledby="h-que-es"
  >
    <!-- Flecha curva punteada decorativa — PNG transparente del cliente -->
    <img
      src="/s3-flecha.png"
      class="s-que-es__deco"
      aria-hidden="true"
      alt=""
      loading="lazy"
      decoding="async"
    />

    <div class="seccion-inner">
      <h2 id="h-que-es" class="s-que-es__h2">
        <span class="s-que-es__h2-top display-light">¿QUÉ ES</span>
        <span class="s-que-es__h2-bottom display-black">
          <Image
            src={imgTedxOficial}
            alt="TEDx"
            width={300}
            height={113}
            loading="lazy"
            decoding="async"
            class="s-que-es__logo-tedx"
          /><span class="s-que-es__signo-final">?</span></span
        >
      </h2>

      <div class="s-que-es__body">
        <p class="s-que-es__p">
          TEDx es un programa oficial de TED, la plataforma de difusión de ideas
          más reconocida del mundo. A través de una licencia oficial, permite
          organizar eventos independientes que mantienen los mismos estándares
          de excelencia, calidad y curaduría que han convertido a TED en un
          referente global.
        </p>
        <p class="s-que-es__p">
          Cada charla TEDx tiene el potencial de trascender el escenario local y
          formar parte de una conversación global, inspirando a miles de
          personas y comunidades alrededor del mundo.
        </p>
        <p class="s-que-es__p">
          Más que una conferencia, TEDx reúne a líderes, científicos,
          emprendedores, académicos y agentes de cambio para compartir ideas
          capaces de desafiar paradigmas y transformar realidades.
        </p>
        <p class="s-que-es__p">
          Ser parte de TEDxBarrioUniversitario Women es sumarse a una marca de
          prestigio internacional que impulsa conversaciones con impacto local y
          proyección global.
        </p>

        <div class="s-que-es__links">
          <p class="s-que-es__badge">
            <span class="s-que-es__badge-arrow" aria-hidden="true">→</span>
            <strong
              >Evento oficial bajo licencia TED<span class="lc">x</span></strong
            >
          </p>
          <a
            href="https://www.ted.com/tedx/events/69535"
            target="_blank"
            rel="noopener"
            class="s-que-es__link s-que-es__link--event"
            aria-label="Ver evento en TED.com, TEDxBarrioUniversitario Women (abre en nueva pestaña)"
          >
            Ver evento en TED.com
            <span aria-hidden="true"> → </span>
            <span class="s-que-es__link-red"
              >TED<span class="lc">x</span>BarrioUniversitario Women</span
            >
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
     S4 — ¿POR QUÉ TEDxWomen?
     Fondo claro + textura. Texto izquierda + polaroid derecho.
     ============================================================ -->
  <section
    id="tedxwomen"
    class="s-mujeres seccion-light texture-overlay"
    aria-labelledby="h-mujeres"
  >
    <div class="seccion-inner s-mujeres__inner">
      <!-- Col izquierda: texto -->
      <div class="s-mujeres__copy">
        <h2 id="h-mujeres" class="s-mujeres__h2">
          <span class="s-mujeres__h2-top display-light">¿POR QUÉ</span>
          <span class="s-mujeres__h2-bottom display-black"
            >TED<span class="lc">x</span>Women?</span
          >
        </h2>

        <p class="s-mujeres__p">
          TEDxWomen No es un evento "sobre mujeres". Es un evento donde las
          mujeres son protagonistas del cambio.
        </p>
        <p class="s-mujeres__p">
          Hoy enfrentamos desafíos urgentes relacionados con liderazgo,
          innovación, bienestar, equidad de género y desarrollo sostenible.
        </p>
        <p class="s-mujeres__p">
          Estamos convencidos que las ideas tienen el poder de abrir nuevas
          posibilidades y movilizar acciones capaces de transformar realidades.
        </p>
        <p class="s-mujeres__p">
          TEDxBarrioUniversitario Women nace para visibilizar nuevas voces,
          compartir experiencias y generar conversaciones que inspiren cambios
          positivos desde la Región del Biobío hacia el mundo.
        </p>
      </div>

      <!-- Col derecha: foto polaroid del diseñador + cita en área blanca -->
      <figure class="s-mujeres__foto-wrap">
        <div class="s-mujeres__polaroid">
          <Image
            src={imgMujerS4}
            alt="Speaker TEDx en el escenario del Barrio Universitario"
            width={680}
            height={775}
            loading="lazy"
            decoding="async"
            class="s-mujeres__foto-bg"
          />
          <img
            src="/s4-marco.png"
            class="s-mujeres__foto-marco"
            aria-hidden="true"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <figcaption class="s-mujeres__foto-cita">
            "Las ideas inspiran.<br />El despegue las vuelve realidad"
          </figcaption>
        </div>
      </figure>
    </div>
  </section>

  <!-- ============================================================
     S5 — ALZAR EL VUELO (concepto)
     Fondo oscuro. Título+copy 2-col, boarding pass fila completa, franja.
     ============================================================ -->
  <section
    id="concepto"
    class="s-concepto dark-section"
    aria-labelledby="h-concepto"
  >
    <div class="seccion-inner s-concepto__inner">
      <!-- Título izquierda con pesos mixtos -->
      <div class="s-concepto__title-col">
        <h2 id="h-concepto" class="s-concepto__h2">
          <span class="s-concepto__h2-l1 display-light">ALZAR</span>
          <span class="s-concepto__h2-l2 display-light">EL</span>
          <span class="s-concepto__h2-l3 display-black">VUELO</span>
        </h2>
      </div>

      <!-- 4 párrafos oficiales columna derecha -->
      <div class="s-concepto__copy-col">
        <p class="s-concepto__p">
          Alzar el Vuelo es una invitación a salir de lo conocido, explorar
          nuevos horizontes y descubrir el poder que tienen las ideas para
          transformar personas, organizaciones y comunidades.
        </p>
        <p class="s-concepto__p">
          En TEDxBarrioUniversitario Women, cada charla será una etapa de este
          viaje: un recorrido por experiencias, aprendizajes e historias que
          inspiran, desafían y movilizan a la acción.
        </p>
        <p class="s-concepto__p">
          Porque cuando una idea encuentra el momento y el lugar para ser
          compartida, tiene el poder de trascender y cambiar realidades.
        </p>
        <p class="s-concepto__p">
          Te invitamos a preparar tu despegue. <strong
            class="s-concepto__p-strong">El viaje comienza aquí.</strong
          >
        </p>
      </div>
    </div>

    <!-- Boarding pass + avión: fila ancho-completo debajo de las columnas -->
    <div class="seccion-inner s-concepto__bp-row">
      <div
        class="boarding-pass s-bp"
        role="img"
        aria-label="Vuelo directo: IDEA 09:00 HRS hasta ACCIÓN 13:00 HRS, viernes 04 de diciembre"
      >
        <div class="boarding-pass__col">
          <span class="boarding-pass__label">Origen</span>
          <span class="boarding-pass__valor">IDEA</span>
          <span class="boarding-pass__hora boarding-pass__hora--hrs mono-date"
            >09:00 HRS</span
          >
          <span class="boarding-pass__hora">Vie 04 dic</span>
        </div>
        <div class="boarding-pass__divider">
          <span class="boarding-pass__directo">Directo</span>
        </div>
        <div class="boarding-pass__col s-bp__dest">
          <span class="boarding-pass__label">Destino</span>
          <span class="boarding-pass__valor">ACCIÓN</span>
          <span class="boarding-pass__hora boarding-pass__hora--hrs mono-date"
            >13:00 HRS</span
          >
          <span class="boarding-pass__hora">Vie 04 dic</span>
        </div>
      </div>

      <!-- Avión animado — WebM VP9 alfa (Chrome/FF/Edge) + GIF fallback (Safari) -->
      <div class="s-avion">
        <!-- Contenedor decorativo aria-hidden; el botón de pausa es hermano (WCAG 2.2.2) -->
        <div class="s-avion__anim" aria-hidden="true">
          <video
            id="avion-video"
            class="s-avion__media"
            autoplay
            muted
            loop
            playsinline
            tabindex="-1"
            poster="/avion-poster.png"
          >
            <source src="/avion.webm" type="video/webm" />
          </video>
          <!-- Fallback para Safari (no soporta VP9 alpha) — gestionado por JS -->
          <img
            id="avion-fallback"
            class="s-avion__media"
            src="/avion-fallback.gif"
            alt=""
            hidden
          />
        </div>
        <!-- Botón pausa accesible — fuera del aria-hidden para que AT lo anuncie (WCAG 2.2.2) -->
        <button
          type="button"
          id="btn-pause-avion"
          class="s-avion__pause"
          aria-label="Pausar animación del avión"
          aria-pressed="false"
        >
          <span aria-hidden="true">⏸</span>
        </button>
      </div>
    </div>

    <!-- Franja inferior: sin aria-hidden (tagline con significado del docx) -->
    <div class="s-concepto__franja">
      <p class="s-concepto__franja-text display-light">
        TODA GRAN TRANSFORMACIÓN COMIENZA CON UNA IDEA
      </p>
    </div>
  </section>

  <!-- ============================================================
     S6 — FICHA TÉCNICA
     Fondo claro. Polaroid izquierda + datos + contadores + temáticas.
     ============================================================ -->
  <section id="evento" class="s-ficha seccion-light" aria-labelledby="h-ficha">
    <div class="seccion-inner s-ficha__inner">
      <!-- Columna izquierda: polaroid patrón S4 (foto + marco overlay + cita en franja blanca) -->
      <div class="s-ficha__left">
        <figure class="s-ficha__polaroid-wrap">
          <div class="s-ficha__polaroid">
            <Image
              src={imgFicha}
              alt="Speaker TEDxBarrioUniversitario Women en el escenario"
              width={450}
              height={512}
              loading="lazy"
              decoding="async"
              class="s-ficha__polaroid-foto"
            />
            <figcaption class="s-ficha__cita">
              "Ideas capaces de cambiar perspectivas y generar acción"
            </figcaption>
          </div>
        </figure>
      </div>

      <!-- Columna derecha: datos + temáticas -->
      <div class="s-ficha__right">
        <!-- Flecha decorativa del cliente — PNG transparente -->
        <img
