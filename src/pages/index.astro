  <!-- ============================================================
     ESTILOS de sección (complementan global.css y BaseLayout)
     ============================================================ -->
  <style>
    /* ── UTILIDADES ─────────────────────────────────────────────── */
    .seccion-light {
      background: var(--color-surface);
    }
    .seccion-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    .seccion-2col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }
    .text-ted-red {
      color: var(--color-ted-red);
    }

    .flecha-roja {
      color: var(--color-ted-red);
      font-weight: 700;
      font-style: normal;
      font-size: 1.1em;
    }

    /* ── S1 HERO ────────────────────────────────────────────────── */
    .s-hero {
      position: relative;
      min-height: 88svh; /* 88% permite que el countdown sea visible sin scroll */
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding-top: 70px; /* compensar header fijo */
    }

    /* Foto full-bleed con gradiente oscuro izquierda→derecha */
    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    /* Desktop: alejar la foto de fondo (s-hero overflow:hidden recorta el exceso) */
    @media (min-width: 901px) {
      .hero-bg {
        inset: -1%;
      } /* subir/bajar este % para más o menos zoom */
    }
    .hero-bg::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to right,
        rgba(0, 0, 0, 0.82) 0%,
        rgba(0, 0, 0, 0.65) 40%,
        rgba(0, 0, 0, 0.3) 70%,
        rgba(0, 0, 0, 0.1) 100%
      );
    }
    .hero-bg__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top; /* desktop: speaker completa desde arriba */
      display: block;
    }

    /* Fila con texto vertical + H1 en paralelo */
    .hero-title-row {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }

    /* BARRIO | UNIVERSITARIO — flex row; writing-mode en cada span para orden predecible */
    .hero-vertical {
      display: flex;
      align-items: flex-start;
      gap: 0.3rem;
      flex-shrink: 0;
      font-family: var(--font-display);
      font-weight: 700;
      /* font-size calibrado para que UNIVERSITARIO (13 chars × 1.28) ≈ altura del H1 */
      font-size: clamp(1.1rem, 2.2vw, 1.9rem);
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.55);
      line-height: 1;
    }
    /* Cada span es un flex item con vertical-lr: top→bottom, orden BARRIO|UNIVERSITARIO */
    .hero-vertical span {
      writing-mode: vertical-lr;
    }

    /* Área de contenido tipográfico */
    .hero-content {
      position: relative;
      z-index: 1;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      width: 100%;
      max-width: 1400px; /* igual que .site-header__inner — alinea en >1400px */
      margin-inline: auto; /* centra el bloque igual que el header */
      /* #2 — padding-inline = mismo clamp que .site-header__inner para alinear lema con logo */
      padding: 2rem clamp(16px, 4vw, 32px);
    }

    .hero-h1 {
      display: flex;
      flex-direction: column;
      line-height: 0.88;
      gap: 0;
      margin: 0;
    }
    .hero-h1__alzar,
    .hero-h1__el {
      font-size: clamp(5rem, 12vw, 11rem);
      color: rgba(255, 255, 255, 0.95);
    }
    .hero-h1__vuelo {
      font-size: clamp(6.5rem, 15vw, 14rem);
      color: #ffffff;
    }

    /* Wordmark PNG del diseñador (ALZAR EL VUELO) */
    .hero-wordmark {
      max-width: clamp(280px, 48vw, 650px);
      height: auto;
      display: block;
    }

    /* ── COUNTDOWN ISLA FLOTANTE ─────────────────────────────────── */
    .cd-island-wrap {
      position: relative;
      z-index: 20;
      display: flex;
      justify-content: center;
      padding: 0 1.5rem;
      margin-top: -4rem; /* solapa sobre el bottom del hero */
    }
    .cd-island {
      background: #111;
      border-radius: 20px;
      padding: 1.75rem 2.5rem;
      max-width: 900px;
      width: 100%;
      box-shadow: 0 12px 48px rgba(0, 0, 0, 0.55);
    }
    .cd-island__inner {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }
    .countdown-unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }
    .countdown-label {
      font-family: var(--font-display);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.65); /* ~5.0:1 ✓ WCAG AA */
      order: -1; /* etiqueta arriba del número */
    }
    .countdown-num {
      font-size: clamp(2.8rem, 7vw, 5rem);
      color: #ffffff;
      line-height: 1;
      background: #1e1e1e;
      border-radius: 8px;
      padding: 0.2rem 0.75rem;
      min-width: 2.5ch;
      text-align: center;
    }
    .countdown-sep {
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: clamp(2rem, 5vw, 3.5rem);
      color: var(--color-ted-red);
      align-self: flex-end;
      padding-bottom: 0.2rem;
      margin-top: 1.4rem; /* alinear con los números, bajo las etiquetas */
    }

    /* ── S2 EQUIPO ──────────────────────────────────────────────── */
    .s-equipo {
      padding: var(--spacing-section) 0;
      padding-top: 7rem; /* espacio para la isla countdown solapada */
    }

    /* Intro 2 columnas */
    .s-equipo__intro {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
      margin-bottom: 3.5rem;
    }
    .s-equipo__intro-left {
      /* vacío: solo organiza el grid */
    }
    .s-equipo__eyebrow {
      margin-bottom: 0.5rem;
      color: var(--color-charcoal);
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 0.85rem;
    }
    .s-equipo__eyebrow .flecha-roja {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
    }
    .s-equipo__titulo {
      font-size: clamp(2rem, 5vw, 3.5rem);
      color: var(--color-charcoal);
      margin-top: 0.25rem;
      line-height: 0.95;
    }
    .s-equipo__desc {
      color: rgba(35, 35, 35, 0.78);
      line-height: 1.7;
      font-size: 1rem;
      font-family: var(--font-sans);
    }

    .equipo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 1rem;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    @media (min-width: 900px) {
      .equipo-grid {
        grid-template-columns: repeat(6, 1fr);
        gap: 0.875rem;
      }
    }

    .equipo-card {
      display: flex;
      flex-direction: column;
      height: 100%; /* estira al alto de la celda grid (la más alta del row) */
      overflow: visible;
      border-radius: 0;
      border: none;
      background: transparent;
    }
    .equipo-card__foto {
      width: 100%;
      aspect-ratio: 1/1;
      object-fit: cover;
      object-position: center top;
      display: block;
      flex-shrink: 0; /* la foto no se encoge aunque sobre espacio */
    }
    .equipo-card__nombre-zona {
      padding: 0.35rem 0.75rem 0.4rem;
      background: var(--color-lavanda);
      text-align: center;
    }
    .equipo-card__nombre {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: inherit;
      margin: 0;
      line-height: 1.2;
    }
    .equipo-card__cargo {
      flex: 1; /* ocupa el espacio sobrante → todas las cards tienen el mismo alto */
      padding: 0.45rem 0.75rem 0.6rem;
      font-size: 0.68rem;
      font-weight: 400;
      text-transform: none;
      letter-spacing: 0;
      color: rgba(35, 35, 35, 0.72);
      font-family: var(--font-sans);
      margin: 0;
      line-height: 1.35;
      background: #fff;
      text-align: center;
    }
    .equipo-card__linkedin {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      color: var(--color-charcoal);
      text-decoration: none;
      transition: color 0.15s;
    }
    .equipo-card__linkedin:hover {
      color: var(--color-ted-red);
    }
    .equipo-card__linkedin:focus-visible {
      outline-color: var(--color-lavanda);
    }
    .equipo-card__linkedin-ico {
      width: 16px;
      height: 16px;
      object-fit: contain;
      display: block;
    }

    /* ── S3 ¿QUÉ ES TEDx? ──────────────────────────────────────── */
    .s-que-es {
      padding: var(--spacing-section) 0;
      background: var(--color-charcoal);
      position: relative;
      overflow: hidden;
    }
    .s-que-es__deco {
      position: absolute;
      top: 0;
      right: 0;
      width: 50%;
      max-width: 400px;
      height: auto;
      pointer-events: none;
      user-select: none;
    }
    .s-que-es__h2 {
      display: flex;
      flex-direction: column;
      color: #fff;
      margin-bottom: 2.5rem;
      line-height: 1;
    }
    .s-que-es__h2-top {
      font-size: clamp(1.4rem, 2.8vw, 2.2rem);
      color: #fff;
    }
    .s-que-es__h2-bottom {
      font-size: clamp(4rem, 10vw, 9rem);
      color: #fff;
      line-height: 0.88;
    }
    .s-que-es__logo-tedx {
      display: inline-block;
      vertical-align: bottom;
      height: 0.88em;
      width: auto;
      margin-right: 2px;
    }
    .s-que-es__signo-final {
      font-size: clamp(1.4rem, 2.8vw, 2.2rem);
      vertical-align: bottom;
      line-height: 1;
    }
    .s-que-es__body {
      max-width: 860px;
    }
    .s-que-es__p {
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.65;
      margin-bottom: 1rem;
      font-weight: 400;
      font-family: var(--font-sans);
    }
    .s-que-es__links {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin-top: 2rem;
    }
    .s-que-es__badge {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #fff;
      font-family: var(--font-display);
      font-weight: 900;
      font-size: 1rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      margin: 0;
    }
    .s-que-es__badge-arrow {
      color: var(--color-ted-red);
      font-size: inherit;
    }
    .s-que-es__link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: rgba(255, 255, 255, 0.75);
      text-decoration: none;
      font-family: var(--font-sans);
      font-weight: 400;
      font-size: 0.95rem;
      transition: color 0.15s;
    }
    .s-que-es__link:hover {
      color: #fff;
    }
    .s-que-es__link--event {
      font-weight: 400;
    }
    .s-que-es__link-red {
      color: var(--color-ted-red);
      font-weight: 700;
      font-family: var(--font-display);
    }

    /* ── S4 ¿POR QUÉ TEDxWOMEN? ──────────────────────────────── */
    .s-mujeres {
      padding: var(--spacing-section) 0;
    }
    .s-mujeres__inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }
    .s-mujeres__h2 {
      display: flex;
      flex-direction: column;
      color: var(--color-charcoal);
      line-height: 1;
      margin: 0 0 1.5rem;
    }
    .s-mujeres__h2-top {
      font-size: clamp(1.2rem, 2.4vw, 1.9rem);
    }
    .s-mujeres__h2-bottom {
      font-size: clamp(2.6rem, 6vw, 4.5rem);
      line-height: 0.9;
    }
    .s-mujeres__p {
      color: rgba(35, 35, 35, 0.8);
      line-height: 1.65;
      margin-bottom: 1rem;
      max-width: 46ch;
    }
    .s-mujeres__foto-wrap {
      max-width: 480px;
      margin: 0 auto;
    }
    .s-mujeres__polaroid {
      position: relative;
    }
    .s-mujeres__foto-bg {
      width: 100%;
      display: block;
    }
    .s-mujeres__foto-marco {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: fill;
      pointer-events: none;
      user-select: none;
    }
    .s-mujeres__foto-cita {
      position: absolute;
      bottom: 8%;
      left: 0;
      right: 0;
      height: 24%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-style: italic;
      font-weight: 700;
      font-family: var(--font-display);
      font-size: clamp(1.05rem, 2.4vw, 1.35rem);
      color: var(--color-charcoal);
      line-height: 1.35;
      padding: 0 1.25rem;
      z-index: 2;
      pointer-events: none;
    }

    /* ── S5 ALZAR EL VUELO (concepto) ──────────────────────────── */
    .s-concepto {
      background: var(--color-charcoal);
      padding: var(--spacing-section) 0 0;
    }
    .s-concepto__inner {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 3rem;
      align-items: start;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem 2.5rem;
    }
    .s-concepto__h2 {
      display: flex;
      flex-direction: column;
      color: #ffffff;
      line-height: 0.92;
      margin: 0;
    }
    .s-concepto__h2-l1 {
      font-size: clamp(2.6rem, 7vw, 6rem);
      letter-spacing: 0.12em;
    }
    .s-concepto__h2-l2 {
      font-size: clamp(2.6rem, 7vw, 6rem);
      letter-spacing: 0.12em;
    }
    .s-concepto__h2-l3 {
      font-size: clamp(2.8rem, 7.5vw, 6.5rem);
      letter-spacing: -0.01em;
    }
    .s-concepto__copy-col {
      padding-top: 0.5rem;
    }
    .s-concepto__p {
      color: rgba(255, 255, 255, 0.82);
      font-family: var(--font-sans);
      font-size: 0.95rem;
      line-height: 1.6;
      margin: 0 0 1rem;
      max-width: 48ch;
    }
    .s-concepto__p:last-child {
      margin-bottom: 0;
    }
    .s-concepto__p-strong {
      color: #fff;
      font-weight: 700;
    }

    /* Boarding pass fila ancho-completo */
    .s-concepto__bp-row {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem 1.5rem;
    }
    .s-bp {
      background: var(--color-lavanda);
      margin-bottom: 1.5rem;
    }
    .s-bp__dest {
      text-align: right;
    }

    /* Avión animado — WebM VP9 + GIF fallback */
    .s-avion {
      position: relative;
      padding: 0.5rem 0;
    }
    .s-avion__anim {
      line-height: 0; /* eliminar espacio inline bajo el video */
    }
    .s-avion__media {
      width: 100%;
      height: auto;
      display: block;
    }
    /* Botón pausa discreto (WCAG 2.2.2) — opaco solo al hover/foco */
    .s-avion__pause {
      position: absolute;
      bottom: 0.35rem;
      right: 0.35rem;
      width: 30px;
      height: 30px;
      border: none;
      border-radius: 4px;
      background: rgba(35, 35, 35, 0.35);
      color: #fff;
      opacity: 0.4;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 0.8rem;
      transition:
        opacity 0.2s,
        background 0.15s;
    }
    .s-avion__pause:hover,
    .s-avion__pause:focus-visible {
      opacity: 1;
      background: var(--color-ted-red);
    }
    .s-avion__pause:focus-visible {
      outline: 2px solid var(--color-ted-red);
      outline-offset: 2px;
    }
    /* Móvil: zoom/recorte para que el avión se vea más grande.
       object-position: left — la animación siempre empieza desde el borde izquierdo,
       el avión entra por la izquierda y viaja hacia la derecha. */
    @media (max-width: 768px) {
      .s-avion__anim {
        height: 80px;
        overflow: hidden;
      }
      .s-avion__media {
        height: 80px;
        object-fit: cover;
        object-position: left center;
      }
    }

    .boarding-pass__hora--hrs {
      font-size: clamp(1.3rem, 3.5vw, 1.9rem);
      font-weight: 900;
      letter-spacing: 0.03em;
      color: var(--color-charcoal);
    }

    /* Franja inferior: sin fondo rojo — texto blanco sobre charcoal */
    .s-concepto__franja {
      padding: 1.25rem 1.5rem 2.75rem;
      text-align: center;
      overflow: hidden;
    }
    .s-concepto__franja-text {
      color: #ffffff;
      font-size: clamp(1rem, 2.6vw, 1.5rem);
      letter-spacing: 0.18em;
      margin: 0;
      white-space: nowrap;
    }

    /* ── S6 FICHA TÉCNICA ──────────────────────────────────────── */
    .s-ficha {
      padding: var(--spacing-section) 0 0;
    }
    .s-ficha__inner {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 4rem;
      align-items: start;
    }

    /* Polaroid */
    .polaroid {
      background: #fff;
      padding: 10px 10px 2.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
      border-radius: 2px;
      display: inline-block;
    }
    .polaroid__img {
      display: block;
      width: 100%;
      height: auto;
    }
    .polaroid__caption {
      font-family: var(--font-display);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(35, 35, 35, 0.65);
      text-align: center;
      margin-top: 0.5rem;
    }
    .polaroid--rotate-left {
      transform: rotate(-3deg);
    }
    .polaroid--rotate-right {
      transform: rotate(3deg);
    }
    .polaroid--tight {
      padding: 10px;
    }

    .s-ficha__right {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      position: relative;
    }
    .s-ficha__h2 {
      display: flex;
      flex-direction: column;
      color: var(--color-charcoal);
      margin: 0 0 0.25rem;
      line-height: 1;
    }
    .s-ficha__h2-top {
      font-size: clamp(1rem, 2vw, 1.5rem);
      color: var(--color-charcoal);
    }
    .s-ficha__h2-bottom {
      font-size: clamp(3rem, 8vw, 6rem);
      color: var(--color-charcoal);
      line-height: 0.9;
      display: block;
    }

    /* Flecha decorativa PNG — apunta a la palabra TÉCNICA desde su derecha */
    .s-ficha__deco {
      position: absolute;
      top: 1rem;
      right: 0;
      width: clamp(240px, 30vw, 300px);
      height: auto;
      pointer-events: none;
      user-select: none;
      z-index: 1;
    }
    @media (max-width: 768px) {
      .s-ficha__deco {
        display: none;
      }
    }

    /* Polaroid S6 — patrón idéntico a S4 */
    .s-ficha__polaroid-wrap {
      max-width: 420px;
      margin: 0 auto;
    }
    .s-ficha__polaroid {
      position: relative;
    }
    .s-ficha__polaroid-foto {
      width: 100%;
      display: block;
    }
    .s-ficha__cita {
      position: absolute;
      bottom: 17%;
      left: 17%;
      right: 17%;
      height: 20%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-style: italic;
      font-weight: 700;
      font-family: var(--font-display);
      font-size: clamp(1.05rem, 2.4vw, 1.35rem);
      color: var(--color-charcoal);
      line-height: 1.35;
      padding: 0 1.25rem;
      z-index: 2;
      pointer-events: none;
    }
    .s-ficha__desc {
      font-size: 0.92rem;
      color: rgba(35, 35, 35, 0.75);
      line-height: 1.6;
      margin: 0;
    }

    /* Franja inferior de contadores */
    .s-ficha__franja {
      margin-top: 3rem;
      border-top: 1.5px solid rgba(35, 35, 35, 0.1);
      padding: 2rem 0;
      background: var(--color-surface);
    }
    .s-ficha__franja-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .s-ficha__franja-udec {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .s-ficha__udec-logo {
      height: clamp(3.5rem, 7vw, 5.25rem);
      width: auto;
      object-fit: contain;
    }
    .s-ficha__udec-label {
      font-family: var(--font-display);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(35, 35, 35, 0.6);
    }
    .s-ficha__franja-sep {
      width: 1px;
      height: 60px;
      background: rgba(35, 35, 35, 0.15);
      flex-shrink: 0;
    }

    /* Contadores distribuidos a lo ancho, número + label en fila */
    .s-ficha__counters {
      display: flex;
      flex: 1;
      justify-content: space-around;
      gap: 1.5rem;
      flex-wrap: wrap;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .counter-item {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 0.6rem;
    }
    .counter-num {
      font-size: clamp(2.5rem, 5vw, 4rem);
      color: var(--color-charcoal);
      line-height: 1;
      flex-shrink: 0;
    }
    .counter-label {
      font-family: var(--font-display);
      font-size: 0.6rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(35, 35, 35, 0.75);
      text-align: left;
      max-width: 6rem;
      line-height: 1.3;
    }

    /* Temáticas */
    .s-ficha__tematicas-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .s-ficha__tematicas-list li {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 0.88rem;
      color: rgba(35, 35, 35, 0.8);
      line-height: 1.45;
    }

    /* ── S7 AUSPICIADORES ─────────────────────────────────────── */
    .s-auspi {
      padding: var(--spacing-section) 0;
      background: var(--color-charcoal);
    }
    .s-auspi__inner {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 4rem;
      align-items: center;
    }
    .s-auspi__h2 {
      display: flex;
      flex-direction: column;
      color: #fff;
      margin: 0 0 1.5rem;
      line-height: 1;
    }
    .s-auspi__h2-top {
      font-size: clamp(0.9rem, 1.8vw, 1.4rem);
      color: #fff;
    }
    .s-auspi__h2-bottom {
      font-size: clamp(2rem, 5vw, 4rem);
      color: #fff;
      line-height: 0.9;
    }
    .s-auspi__intro {
      font-size: 0.92rem;
      color: rgba(255, 255, 255, 0.75);
      line-height: 1.6;
      margin: 0 0 1.25rem;
    }
    .s-auspi__bullets {
      list-style: none;
      padding: 0;
      margin: 0 0 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .s-auspi__bullet {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.82);
      line-height: 1.55;
    }
    .s-auspi__polars {
      position: relative;
      width: 380px;
      height: 480px;
      flex-shrink: 0;
    }
    .polaroid--stack-back {
      position: absolute;
      width: 240px;
      top: 0;
      left: 0;
      transform: rotate(-7deg);
      z-index: 1;
    }
    .polaroid--stack-front {
      position: absolute;
      width: 290px;
      bottom: 0;
      right: 0;
      transform: rotate(3deg);
      z-index: 2;
    }
    .polaroid__img--cover {
      object-fit: cover;
      width: 100%;
      height: 200px;
    }
    .polaroid__caption--quote {
      font-style: italic;
      font-weight: 700;
      font-size: 0.88rem;
      color: var(--color-charcoal);
      text-align: center;
      text-transform: none;
      letter-spacing: normal;
      line-height: 1.4;
      padding: 0.25rem 0.5rem;
    }

    /* H2 auspiciador simplificado */
    .s-auspi__h2--simple {
      font-size: clamp(3rem, 8vw, 7rem);
      line-height: 0.9;
    }

    /* Imagen compuesta del diseñador (auspiciador) */
    .s-auspi__img-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }
    .s-auspi__polaroid {
      position: relative;
      max-width: 740px;
      width: 100%;
      margin: 0;
      padding: 0;
    }
    .s-auspi__img {
      width: 100%;
      height: auto;
      border-radius: 4px;
      display: block;
    }
    .s-auspi__cita {
      position: absolute;
      left: 36%;
      right: 20%;
      bottom: 4%;
      height: 22%;
      margin: 0;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: var(--color-charcoal);
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 700;
      font-size: clamp(1.05rem, 2.4vw, 1.35rem);
      line-height: 1.35;
      padding: 0 1.25rem;
      z-index: 2;
      pointer-events: none;
    }

    /* ── S8 BENEFICIOS ────────────────────────────────────────── */
    .s-beneficios {
      padding: var(--spacing-section) 0;
    }
    .s-beneficios__header {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;
      margin-bottom: 2.5rem;
    }
    .s-beneficios__h2 {
      display: flex;
      flex-direction: column;
      line-height: 0.9;
      margin-top: 0.25rem;
      margin-bottom: 0;
    }
    .s-beneficios__h2-top {
      font-size: clamp(2.8rem, 7vw, 5.5rem);
      color: var(--color-charcoal);
      line-height: 0.88;
    }
    .s-beneficios__h2-sub {
      font-size: clamp(0.85rem, 2vw, 1.25rem);
      color: var(--color-charcoal);
      letter-spacing: 0.02em;
      margin-top: 0.3rem;
    }
    .s-beneficios__pregunta {
      font-family: var(--font-display);
      font-weight: 900;
      font-size: clamp(1rem, 2.2vw, 1.35rem);
      text-transform: uppercase;
      color: var(--color-charcoal);
      margin: 0 0 0.75rem;
      line-height: 1.15;
    }
    .s-beneficios__intro {
      font-size: 0.88rem;
      color: rgba(35, 35, 35, 0.7);
      line-height: 1.65;
      margin: 0 0 1rem;
    }

    /* Fila minimalista de beneficios */
    .beneficios-fila {
      list-style: none;
      padding: 0;
      margin: 0 0 2.5rem;
      display: flex;
      align-items: center;
      gap: 0;
      flex-wrap: nowrap;
    }
    .beneficio-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1.25rem 1.5rem;
      flex: 1 1 0;
      min-width: 0;
      position: relative;
    }
    .beneficio-flecha {
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      font-weight: 900;
      flex-shrink: 0;
      line-height: 1;
    }
    .beneficio-nombre {
      font-size: clamp(
        1.1rem,
        2vw,
        1.4rem
      ); /* aumentado — nombres de beneficio más legibles */
      letter-spacing: 0.04em;
      color: var(--color-charcoal);
      font-weight: 900;
      font-family: var(--font-display);
    }
    .beneficio-sep {
      display: none;
    }

    .s-beneficios__btn {
      display: inline-block;
      margin-top: 1.5rem;
    }

    /* ── S9 SPEAKERS ──────────────────────────────────────────── */
    .s-speakers {
      padding: var(--spacing-section) 0;
      background: var(--color-charcoal);
    }
    .s-speakers__header {
      text-align: left;
      margin-bottom: 3rem;
    }
    .s-speakers__h2 {
      display: flex;
      flex-direction: column;
      color: #fff;
      margin: 0 0 0.75rem;
      line-height: 1;
    }
    .s-speakers__h2-top {
      font-size: clamp(0.9rem, 1.8vw, 1.4rem);
      color: #fff;
    }
    .s-speakers__h2-bottom {
      font-size: clamp(3rem, 8vw, 6rem);
      color: #fff;
      line-height: 0.9;
      position: relative;
      display: block;
    }
    .s-speakers__intro {
      margin: 0 0 2.5rem;
    }
    .s-speakers__sub {
      color: rgba(255, 255, 255, 0.9);
      font-weight: 700;
      font-size: 1rem;
    }

    .s-speakers__layout {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 4rem;
      align-items: start;
    }
    .s-speakers__photo-wrap {
      position: relative;
      display: inline-block;
    }
    .s-speakers__photo-img {
      display: block;
      border-radius: 4px;
      max-width: 380px;
    }
    .s-speakers__tu-nombre {
      position: absolute;
      bottom: 1.5rem;
      left: 0;
      right: 0;
      text-align: center;
      color: #fff;
      font-size: 1.3rem;
      letter-spacing: 0.12em;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    }

    .s-speakers__quienes {
      margin-bottom: 2rem;
    }
    .s-speakers__quienes-desc {
      font-size: 0.88rem;
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.6;
      margin: 0 0 0.85rem;
    }
    .s-speakers__quienes-sub {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.65);
      line-height: 1.5;
      margin: 0 0 0.6rem;
    }
    .s-speakers__quienes-h {
      font-size: 1.05rem;
      color: #fff;
      margin-bottom: 0.5rem;
      margin-top: 1rem;
    }
    .s-speakers__quienes-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }
    .s-speakers__quienes-item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 0.88rem;
      color: rgba(255, 255, 255, 0.82);
      line-height: 1.5;
    }

    /* Proceso 3 etapas */
    .s-proceso {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-bottom: 2.5rem;
      position: relative;
    }
    .s-proceso__step {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      padding-bottom: 1.5rem;
      position: relative;
    }
    .s-proceso__step:not(:last-child)::after {
      content: "";
      position: absolute;
      left: 18px;
      top: 36px;
      width: 2px;
      height: calc(100% - 20px);
      background: rgba(255, 255, 255, 0.15);
    }
    .s-proceso__num {
      min-width: 36px;
      height: 36px;
      background: var(--color-ted-red);
      color: #fff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      font-weight: 700;
      flex-shrink: 0;
    }
    .s-proceso__content {
      padding-top: 4px;
    }
    .s-proceso__title {
      font-size: 0.9rem;
      color: #fff;
      margin: 0 0 0.25rem;
    }
    .s-proceso__desc {
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.65);
      line-height: 1.5;
      margin: 0;
    }

    .s-speakers__cta {
      margin-top: 2rem;
    }
    .s-speakers__cta-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(0.85rem, 1.8vw, 1.05rem);
      color: rgba(255, 255, 255, 0.9);
      letter-spacing: 0.04em;
      margin-bottom: 1rem;
    }

    /* ── S10 PARTNERS ────────────────────────────────────────── */
    .s-partners {
      padding: var(--spacing-section) 0;
    }
    .s-partners__header {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .s-partners__h2 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      color: var(--color-charcoal);
      margin: 0.5rem 0 0.5rem;
    }
    .s-partners__sub {
      color: rgba(35, 35, 35, 0.65);
      font-size: 0.95rem;
      margin-bottom: 0.5rem;
    }
    .s-partners__desc {
      font-size: 0.88rem;
      color: rgba(35, 35, 35, 0.65);
      line-height: 1.65;
      max-width: 680px;
      margin: 0 auto;
    }

    .partners-carousel {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .partners-track-wrap {
      flex: 1;
      overflow: hidden;
      border: 1.5px solid rgba(35, 35, 35, 0.1);
      border-radius: 4px;
      min-height: 200px;
    }
    .partners-track {
      display: flex;
      width: 100%; /* necesario para que calc(100%/N) en slides sea relativo al wrap */
      transition: transform 0.35s ease;
    }
    .partners-slide {
      flex: 0 0 100%; /* móvil: 1 visible */
      min-width: 0; /* evita que contenido ancho fuerce el slide más allá del flex-basis */
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between; /* empuja el label de categoría al fondo */
      gap: 1rem;
      min-height: 180px;
    }
    @media (min-width: 640px) {
      .partners-slide {
        flex-basis: calc(100% / 3);
      }
    }
    @media (min-width: 1024px) {
      .partners-slide {
        flex-basis: 20%;
      }
    }
    .partners-slide__cat {
      text-align: center;
      color: var(--color-charcoal);
    }
    .partners-slide__cat .flecha-roja {
      font-size: 1.6em; /* más grande y visible que la flecha global (1.1em) */
    }
    .partners-slide__logos {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      min-height: 120px;
    }
    .partners-slide__logos--multi {
      flex-direction: column;
      gap: 0.75rem;
    }
    .partners-logo {
      height: 80px;
      width: auto;
      max-width: 160px;
      object-fit: contain;
    }
    .partners-logo--anfitrion {
      height: 110px;
      max-width: 220px;
    }
    @media (max-width: 639px) {
      .partners-logo {
        height: 70px;
        max-width: 140px;
      }
      .partners-logo--anfitrion {
        height: 90px;
        max-width: 180px;
      }
    }

    .partners-prev,
    .partners-next {
      background: var(--color-charcoal);
      color: #fff;
      border: none;
      border-radius: 4px;
      width: 38px;
      height: 38px;
      font-size: 1.4rem;
      line-height: 1;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s;
      flex-shrink: 0;
    }
    .partners-prev:hover,
    .partners-next:hover {
      background: var(--color-ted-red);
    }
    .partners-prev:focus-visible,
    .partners-next:focus-visible {
      outline: 2px solid var(--color-ted-red);
      outline-offset: 2px;
    }

    .partners-pause {
      background: var(--color-charcoal);
      color: #fff;
      border: none;
      border-radius: 4px;
      width: 38px;
      height: 38px;
      font-size: 1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.15s;
      margin: 0 auto;
    }
    .partners-pause:hover {
      background: var(--color-ted-red);
    }
    .partners-pause:focus-visible {
      outline: 2px solid var(--color-ted-red);
      outline-offset: 2px;
    }

    .partners-dots {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .partners-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(35, 35, 35, 0.45); /* ≥3:1 sobre #f7f7f7 (WCAG 1.4.11) */
      border: none;
      padding: 6px; /* área táctil 20px sin cambiar visual */
      box-sizing: content-box;
      cursor: pointer;
      transition: background 0.15s;
    }
    .partners-dot--active,
    .partners-dot:hover {
      background: var(--color-ted-red);
    }

    .s-partners__cta-text {
      text-align: center;
      font-size: 0.9rem;
      color: rgba(35, 35, 35, 0.7);
    }
    .s-partners__link {
      font-family: var(--font-display);
      font-weight: 700;
      text-decoration: none;
      letter-spacing: 0.04em;
    }
    .s-partners__link:hover {
      text-decoration: underline;
    }

    /* Layout split Partners: título izq + párrafo der */
    .s-partners__header--split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: end;
      text-align: left;
      margin-bottom: 2.5rem;
    }
    .s-partners__header-left {
      /* solo organiza el grid */
    }

    /* Sin bordes en logos de partners */
    .partners-logo {
      border: none !important;
    }

    /* ── S11 CONTACTO ─────────────────────────────────────────── */
    .s-contacto {
      position: relative;
      min-height: clamp(440px, 50vw, 780px);
      background:
        linear-gradient(
          90deg,
          rgba(20, 20, 20, 0.88) 0%,
          rgba(20, 20, 20, 0.72) 40%,
          rgba(20, 20, 20, 0.08) 68%,
          transparent 100%
        ),
        url("/fondo-contacto-desktop.png") center / cover no-repeat;
    }
    .s-contacto__inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
      padding-top: var(--spacing-section);
      padding-bottom: var(--spacing-section);
    }
    .s-contacto__h2 {
      font-size: clamp(2.5rem, 6vw, 5rem);
      color: #ffffff;
      margin: 0.25rem 0 0.5rem;
    }
    .s-contacto__subtitulo {
      color: rgba(255, 255, 255, 0.72);
      font-size: 1rem;
      margin: 0 0 0.75rem;
      font-family: var(--font-sans);
    }
    .s-contacto__intro {
      font-size: 0.88rem;
      color: rgba(255, 255, 255, 0.62);
      line-height: 1.6;
      margin: 0 0 1.5rem;
    }
    .s-contacto__email {
      display: block;
      font-size: clamp(0.9rem, 2vw, 1.2rem);
      color: var(--color-lavanda);
      text-decoration: none;
      margin-bottom: 2rem;
      word-break: break-all;
    }
    .s-contacto__email:hover {
      color: #fff;
    }
    .s-contacto__redes-label {
      font-family: var(--font-display);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 0.75rem; /* era 0.55 (~3.9:1 falla) → 0.70 (~5.2:1 ✓ WCAG AA) */
    }
    .s-contacto__redes {
      display: flex;
      flex-direction: row;
      gap: 1rem;
      align-items: center;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .s-contacto__red {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 4px; /* toca área ≥ 52×52px (WCAG 2.5.5 AAA) */
      text-decoration: none;
      color: rgba(255, 255, 255, 0.82);
      transition: color 0.15s;
    }
    .s-contacto__red span {
      display: none; /* oculto visualmente; nombre accesible en aria-label del <a> */
    }
    .s-contacto__red:hover {
      color: var(--color-lavanda);
    }
    .s-contacto__red:focus-visible {
      outline: 2px solid var(--color-lavanda);
      outline-offset: 4px;
      border-radius: 50%;
    }
    .s-contacto__red-ico {
      width: 44px;
      height: 44px;
      object-fit: contain;
      border-radius: 50%;
    }

    /* S11 col derecha: polaroid DOM (se muestra solo en móvil; escritorio usa fondo horneado) */
    .s-contacto__photo-col {
      display: none;
    }
    .s-contacto__polaroid-wrap {
      position: relative;
      display: block;
      max-width: 380px;
      margin: 0 auto;
      background: #fff;
    }
    .s-contacto__foto {
      width: 100%;
      height: auto;
      display: block;
      object-fit: cover;
    }
    .s-contacto__marco {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: fill;
      pointer-events: none;
    }
    .s-contacto__cita-fig {
      position: absolute;
      bottom: 8%;
      left: 10%;
      right: 10%;
      height: 24%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-style: italic;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(1.05rem, 2.4vw, 1.35rem);
      color: var(--color-charcoal);
      text-align: center;
      line-height: 1.35;
    }

    /* Cita S11 escritorio: texto sobre el polaroid horneado en fondo-contacto-desktop.png */
    .s-contacto__cita-polaroid {
      position: absolute;
      /* polaroid en fondo-contacto-desktop.png: ~57–89% horizontal, zona blanca ~70–90% vertical */
      /* centrado en la franja blanca del polaroid (~10–30% desde abajo → centro ~20%) */
      bottom: 18%;
      left: 57%;
      right: 14%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-style: italic;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(1.05rem, 2.4vw, 1.35rem);
      color: var(--color-charcoal);
      text-align: center;
      line-height: 1.35;
      pointer-events: none;
      z-index: 1;
      margin: 0;
    }

    /* ── PARALLAX ────────────────────────────────────────────── */
    .parallax-img {
      overflow: hidden;
    }
    .parallax-img img {
      will-change: transform;
    }

    /* ── RESPONSIVE ──────────────────────────────────────────── */
    /* Tablet → 3 slides visibles */
    @media (min-width: 640px) {
      .partners-slide {
        flex: 0 0 33.333%;
      }
    }

    /* Desktop → 5 slides visibles a la vez */
    @media (min-width: 1024px) {
      .partners-slide {
        flex: 0 0 20%;
      }
    }

    @media (max-width: 900px) {
      /* Hero móvil: encuadrar speaker (derecha de la foto) sin cortar la cabeza */
      .hero-bg__img {
        object-position: 72% 20%;
      }
      /* Reducir min-height para que el countdown quede visible bajo el hero */
      .s-hero {
        min-height: 82svh;
      }
      .hero-inner {
        grid-template-columns: 1fr;
        padding-top: 2.5rem;
      }
      .hero-photo {
        display: none;
      } /* ocultamos foto hero en móvil para dar espacio al texto */
      .hero-countdown__inner {
        gap: 0.6rem;
      }

      /* S11 CONTACTO móvil: fondo oscuro limpio, polaroid DOM visible debajo del texto */
      .s-contacto {
        background:
          linear-gradient(
            180deg,
            rgba(20, 20, 20, 0.84),
            rgba(20, 20, 20, 0.6)
          ),
          url("/s11-fondo-mobile.webp") center / cover no-repeat;
      }
      /* Mostrar polaroid DOM (oculto en escritorio) */
      .s-contacto__photo-col {
        display: block;
      }
      /* Ocultar cita de escritorio; el figure tiene su propia figcaption */
      .s-contacto__cita-polaroid {
        display: none;
      }

      /* Secciones de 2 columnas → 1 columna en móvil */
      .s-mujeres__inner {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
      .s-concepto__inner {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .s-ficha__inner {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      /* Ficha técnica: heading antes del polaroid en móvil (mejora secuencia visual) */
      .s-ficha__right {
        order: -1;
      }
      .s-ficha__polaroid-wrap {
        max-width: 320px;
      }

      .s-contacto__inner {
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      /* Speakers: 2 columnas → 1 columna en móvil (foto arriba, info + botón abajo) */
      .s-speakers__layout {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .s-speakers__photo-img {
        max-width: 280px;
        margin: 0 auto;
        display: block;
      }

      .s-auspi__polars {
        width: 100%;
        height: 340px;
      }
      /* Auspiciador: apila columnas en móvil — texto arriba, imagen abajo */
      .s-auspi__inner {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }
      .s-auspi__img-wrap {
        align-items: center;
      }
      .s-auspi__polaroid {
        margin-left: 0;
        max-width: 100%;
      }
      .s-auspi__cita {
        left: 32%;
        right: 14%;
        font-size: clamp(0.9rem, 3.5vw, 1.05rem);
      }
      .beneficios-fila {
        flex-wrap: wrap;
      }
      .beneficio-item {
        flex: 1 1 45%;
      }
      .s-beneficios__header {
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }

      .s-concepto__franja-text {
        white-space: normal;
      }

      .s-ficha__franja-sep {
        display: none;
      }
    }

    @media (max-width: 768px) {
      .s-equipo__intro {
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }
      .cd-island {
        border-radius: 12px;
        padding: 1.25rem 1rem;
      }
      .cd-island__inner {
        gap: 0.5rem;
      }
      .s-partners__header--split {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .equipo-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .beneficio-item {
        flex: 1 1 100%;
      }
      .s-auspi__polars {
        width: 100%;
        height: 300px;
      }
      .polaroid--stack-back {
        width: 55%;
      }
      .polaroid--stack-front {
        width: 58%;
      }
      .s-ficha__counters {
        gap: 1.25rem;
      }
      .s-ficha__franja-inner {
        gap: 1.5rem;
      }
      .countdown-num {
        font-size: clamp(1.8rem, 8vw, 2.5rem);
        padding: 0.15rem 0.4rem;
      }
      .countdown-sep {
        font-size: clamp(1.2rem, 5vw, 2rem);
      }
      .cd-island-wrap {
        padding: 0 0.75rem;
        margin-top: -2.5rem;
      }
      /* #10 — Textos más grandes en móvil */
      .s-que-es__p {
        font-size: 1rem;
      }
      .beneficio-nombre {
        font-size: 1rem;
        letter-spacing: 0.03em;
      }
      .s-auspi__bullet {
        font-size: 1rem;
      }
    }
  </style>

  <!-- ============================================================
     JAVASCRIPT — Countdown, CountUp, Carrusel, Parallax
     Todo bajo prefers-reduced-motion
     ============================================================ -->
  <script>
    (function (): void {
      "use strict";

      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      /* ── AVIÓN ANIMADO (WCAG 2.2.2) ─────────────────────────── */
      const avionVideo = document.getElementById(
        "avion-video",
      ) as HTMLVideoElement | null;
      const avionFallback = document.getElementById(
        "avion-fallback",
      ) as HTMLImageElement | null;
      const btnPauseAvion = document.getElementById(
        "btn-pause-avion",
      ) as HTMLButtonElement | null;
      let avionUsesGif = false;

      if (avionVideo) {
        if (prefersReduced) {
          // Reduced-motion: mostrar solo el poster estático
          avionVideo.pause();
          if (btnPauseAvion) btnPauseAvion.hidden = true;
        } else {
          const supportsVP9 =
            avionVideo.canPlayType('video/webm; codecs="vp9"') !== "";
          if (supportsVP9) {
            avionVideo.play().catch(() => {});
          } else {
            // Safari: ocultar video (muestra poster), mostrar GIF animado
            avionUsesGif = true;
            avionVideo.style.display = "none";
            if (avionFallback) avionFallback.hidden = false;
          }

          // Botón pausa/play persistente (WCAG 2.2.2)
          if (btnPauseAvion) {
            btnPauseAvion.addEventListener("click", () => {
              const pressed =
                btnPauseAvion.getAttribute("aria-pressed") === "true";
              const nowPaused = !pressed;
              const ico = btnPauseAvion.querySelector("span");
              btnPauseAvion.setAttribute("aria-pressed", String(nowPaused));

              if (nowPaused) {
                btnPauseAvion.setAttribute(
                  "aria-label",
                  "Reanudar animación del avión",
                );
                if (ico) ico.textContent = "▶";
                if (avionUsesGif) {
                  // GIF: ocultar GIF → video muestra el poster
                  if (avionFallback) avionFallback.hidden = true;
                  avionVideo.style.display = "";
                } else {
                  avionVideo.pause();
                }
              } else {
                btnPauseAvion.setAttribute(
                  "aria-label",
                  "Pausar animación del avión",
                );
                if (ico) ico.textContent = "⏸";
                if (avionUsesGif) {
                  avionVideo.style.display = "none";
                  if (avionFallback) avionFallback.hidden = false;
                } else {
                  avionVideo.play().catch(() => {});
                }
              }
            });
          }
        }
      }

      /* ── COUNTDOWN ───────────────────────────────────────────── */
      const TARGET = new Date("2026-12-04T09:00:00-03:00").getTime();
      const cdDias = document.getElementById("cd-dias");
      const cdHoras = document.getElementById("cd-horas");
      const cdMin = document.getElementById("cd-min");
      const cdSeg = document.getElementById("cd-seg");

      function pad(n: number): string {
        return String(n).padStart(2, "0");
      }

      function tickCountdown(): void {
        const diff = TARGET - Date.now();
        if (diff <= 0) {
          if (cdDias) cdDias.textContent = "00";
          if (cdHoras) cdHoras.textContent = "00";
          if (cdMin) cdMin.textContent = "00";
          if (cdSeg) cdSeg.textContent = "00";
          return;
        }
        const days = Math.floor(diff / 86400000);
        const hours = Math.floor((diff % 86400000) / 3600000);
        const mins = Math.floor((diff % 3600000) / 60000);
        const secs = Math.floor((diff % 60000) / 1000);
        if (cdDias) cdDias.textContent = String(days);
        if (cdHoras) cdHoras.textContent = pad(hours);
        if (cdMin) cdMin.textContent = pad(mins);
        if (cdSeg) cdSeg.textContent = pad(secs);
      }

      if (prefersReduced) {
        const remaining = Math.max(0, TARGET - Date.now());
        const days = Math.floor(remaining / 86400000);
        if (cdDias) cdDias.textContent = String(days);
        if (cdHoras) cdHoras.textContent = "--";
        if (cdMin) cdMin.textContent = "--";
        if (cdSeg) cdSeg.textContent = "--";
      } else {
        tickCountdown();
        setInterval(tickCountdown, 1000);
      }

      /* ── COUNT-UP COUNTERS ───────────────────────────────────── */
      const counterEls = document.querySelectorAll<HTMLElement>(".js-counter");

      const allCounters = Array.from(counterEls).map((el) => ({
        el,
        target: parseInt(el.dataset.target ?? "0", 10),
        pad: parseInt(el.dataset.pad ?? "0", 10),
      }));

      const fmt = (n: number, pad: number) =>
        pad > 0 ? String(n).padStart(pad, "0") : String(n);

      if (prefersReduced) {
        allCounters.forEach(({ el, target, pad }) => {
          el.textContent = fmt(target, pad);
        });
      } else {
        const runCounter = (
          el: HTMLElement,
          target: number,
          pad: number,
        ): void => {
          const duration = 1200;
          const step = 16;
          const inc = Math.ceil(target / (duration / step));
          let current = 0;
          const timer = setInterval(() => {
            current = Math.min(current + inc, target);
            el.textContent = fmt(current, pad);
            if (current >= target) clearInterval(timer);
          }, step);
        };

        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const item = allCounters.find((c) => c.el === entry.target);
              if (item) {
                runCounter(item.el, item.target, item.pad);
                obs.unobserve(item.el);
              }
            });
          },
          { threshold: 0.5 },
        );

        allCounters.forEach(({ el, pad }) => {
          el.textContent = fmt(0, pad);
          obs.observe(el);
        });
      }

      /* ── PARTNERS CAROUSEL ───────────────────────────────────── */
      const track = document.getElementById("partners-track");
      const dotsEl = document.getElementById("partners-dots");
      const btnPrev = document.getElementById("btn-prev");
      const btnNext = document.getElementById("btn-next");
      const announceEl = document.getElementById("carousel-announce");

      if (track && dotsEl && btnPrev && btnNext) {
        let current = 0;
        const slides = track.children.length;
        const slideEls = Array.from(track.children);
        const dots = dotsEl.querySelectorAll(".partners-dot");
        let announceTimer: ReturnType<typeof setTimeout> | null = null;

        const getVisible = (): number => {
          if (window.innerWidth >= 1024) return slides; // todos a la vez → sin nav
          if (window.innerWidth >= 640) return 3;
          return 1;
        };

        const updateControls = (): void => {
          const visible = getVisible();
          const allVisible = visible >= slides;
          (btnPrev as HTMLElement).style.display = allVisible ? "none" : "";
          (btnNext as HTMLElement).style.display = allVisible ? "none" : "";
          dotsEl.style.display = allVisible ? "none" : "";
          if (allVisible) {
            track.style.transform = "translateX(0)";
            current = 0;
          }
        };

        const goTo = (idx: number): void => {
          const visible = getVisible();
          if (visible >= slides) return; // todos visibles, sin scroll
          const maxPos = slides - visible;
          current = Math.max(0, Math.min((idx + slides) % slides, maxPos));
          track.style.transform = `translateX(-${current * (100 / slides)}%)`;
          dots.forEach((d, i) => {
            d.classList.toggle("partners-dot--active", i === current);
            d.setAttribute("aria-pressed", i === current ? "true" : "false");
          });
          if (announceEl) {
            const visNames = slideEls
              .slice(current, current + visible)
              .map((s) => s.getAttribute("aria-label") ?? "")
              .filter(Boolean)
              .join(", ");
            if (announceTimer !== null) clearTimeout(announceTimer);
            announceEl.textContent = `Mostrando: ${visNames}`;
            announceTimer = setTimeout(() => {
              announceEl.textContent = "";
            }, 2000);
          }
        };

        btnPrev.addEventListener("click", () => goTo(current - 1));
        btnNext.addEventListener("click", () => goTo(current + 1));
        dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));
        window.addEventListener("resize", updateControls, { passive: true });
        updateControls();

        /* ── AUTOPLAY (WCAG 2.2.2: pausa en hover, foco y botón explícito) ── */
        const btnPause = document.getElementById(
          "btn-pause-carousel",
        ) as HTMLButtonElement | null;
        let autoPaused = false;
        let autoTimer: ReturnType<typeof setInterval> | null = null;

        const startAuto = (): void => {
          if (autoPaused || prefersReduced) return;
          if (getVisible() >= slides) return; // todos visibles en desktop → sin efecto
          if (autoTimer !== null) return;
          autoTimer = setInterval(() => goTo(current + 1), 4000);
        };
        const stopAuto = (): void => {
          if (autoTimer !== null) {
            clearInterval(autoTimer);
            autoTimer = null;
          }
        };

        // Botón pausa/play persistente (WCAG 2.2.2)
        if (btnPause) {
          btnPause.addEventListener("click", () => {
            autoPaused = !autoPaused;
            if (autoPaused) {
              stopAuto();
              btnPause.setAttribute("aria-pressed", "true");
              btnPause.setAttribute(
                "aria-label",
                "Reanudar rotación automática del carrusel",
              );
              const ico = btnPause.querySelector("span");
              if (ico) ico.textContent = "▶";
            } else {
              btnPause.setAttribute("aria-pressed", "false");
              btnPause.setAttribute(
                "aria-label",
                "Pausar rotación automática del carrusel",
              );
              const ico = btnPause.querySelector("span");
              if (ico) ico.textContent = "⏸";
              startAuto();
            }
          });
        }

        // Pausa temporal en hover / foco del teclado
        const carouselEl = document.querySelector(
          ".partners-carousel",
        ) as HTMLElement | null;
        carouselEl?.addEventListener("mouseenter", stopAuto);
        carouselEl?.addEventListener("focusin", stopAuto);
        carouselEl?.addEventListener("mouseleave", () => {
          if (!autoPaused) startAuto();
        });
        carouselEl?.addEventListener("focusout", (e: FocusEvent) => {
          if (
            !carouselEl.contains(e.relatedTarget as Node | null) &&
            !autoPaused
          )
            startAuto();
        });

        // Ocultar botón pausa junto con prev/next cuando todos los slides son visibles
        const origUpdateControls = updateControls;
        // Extender updateControls para incluir btnPause
        window.addEventListener(
          "resize",
          () => {
            if (btnPause)
              btnPause.style.display = getVisible() >= slides ? "none" : "";
          },
          { passive: true },
        );
        if (btnPause)
          btnPause.style.display = getVisible() >= slides ? "none" : "";

        startAuto();
      }

      /* ── PARALLAX (fotos grandes) ────────────────────────────── */
      if (!prefersReduced && window.innerWidth > 768) {
        const parallaxItems =
          document.querySelectorAll<HTMLElement>(".parallax-img img");
        if (parallaxItems.length) {
          let ticking = false;
          const onScroll = (): void => {
            if (!ticking) {
              requestAnimationFrame(() => {
                parallaxItems.forEach((img) => {
                  const wrap = img.closest(".parallax-img");
                  if (!wrap) return;
                  const rect = wrap.getBoundingClientRect();
                  const centerY = rect.top + rect.height / 2;
                  const offset = (window.innerHeight / 2 - centerY) * 0.08;
                  img.style.transform = `translateY(${offset}px)`;
                });
                ticking = false;
              });
              ticking = true;
            }
          };
          window.addEventListener("scroll", onScroll, { passive: true });
        }
      }

      /* ── SCROLL REVEALS ──────────────────────────────────────── */
      if (!prefersReduced) {
        const revealEls = document.querySelectorAll<HTMLElement>(
          ".equipo-card, .beneficio-card, .s-proceso__step, .s-auspi__bullet",
        );
        if (revealEls.length) {
          const revObs = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const el = entry.target as HTMLElement;
                  el.style.opacity = "1";
                  el.style.transform = "translateY(0)";
                  revObs.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.15 },
          );

          revealEls.forEach((el, i) => {
            el.style.opacity = "0";
            el.style.transform = "translateY(24px)";
            el.style.transition = `opacity 0.45s ease ${i * 0.05}s, transform 0.45s ease ${i * 0.05}s`;
            revObs.observe(el);
          });
        }
      }
    })();
  </script>
</BaseLayout>
